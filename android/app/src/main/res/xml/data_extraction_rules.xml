<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 и новее. В базе и файлах приложения есть персональные данные (контакты
     заказчиков, подписи, акты), в настройках — зашифрованные токены сервера и хеш PIN.
     Ничего из этого не копируется ни в облачную резервную копию, ни при переносе на новый
     телефон (device-transfer работает даже при allowBackup="false", поэтому запрет здесь).
     Ключи Android Keystore система не копирует никогда — токены и хеш PIN на другом
     телефоне всё равно не расшифровать и не проверить.
     device_* — область хранения, доступная до первой разблокировки телефона (не используется,
     закрыта на будущее). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
